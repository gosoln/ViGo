<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Id="ViGo.InputMethod.Windows"
    Name="ViGo"
    Manufacturer="ViGo contributors"
    Version="2.0.0"
    Scope="perMachine">

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ViGo.ico" SourceFile="$(var.RepositoryDir)\assets\icon\ViGo.ico" />
    <Property Id="ARPPRODUCTICON" Value="ViGo.ico" />

    <Property Id="VIGO_TSF_PREVIOUS_DLL" Secure="yes">
      <RegistrySearch
        Id="FindPreviousTsfDll"
        Root="HKLM"
        Key="Software\Classes\CLSID\{027A6B19-4551-46F7-B8FD-FB09AE4135BA}\InProcServer32"
        Type="raw"
        Bitness="always64" />
    </Property>
    <Property Id="VIGO_TEST_FAIL_AFTER_REGISTER" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ViGo">
        <Component Id="TsfComponent" Guid="*" Bitness="always64">
          <File Id="TsfDll" Source="$(var.ViGoBuildDir)\ViGoTSF.dll" KeyPath="yes" />
        </Component>
        <Component Id="SettingsComponent" Guid="*" Bitness="always64">
          <File Id="SettingsExe" Source="$(var.ViGoBuildDir)\ViGoSettings.exe" KeyPath="yes" />
        </Component>
        <!-- The Start menu shortcut lives in its own component with an HKCU key path (ICE43, ICE57). -->
        <Component Id="SettingsShortcutComponent" Guid="*">
          <Shortcut
            Id="SettingsShortcut"
            Directory="ProgramMenuFolder"
            Name="ViGo"
            Description="Tùy chọn bộ gõ tiếng Việt ViGo"
            Target="[#SettingsExe]"
            Arguments="--settings"
            WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU" Key="Software\ViGo\Installer" Name="SettingsShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
        <Component Id="LicenseComponent" Guid="*" Bitness="always64">
          <File Id="LicenseFile" Source="$(var.RepositoryDir)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
        </Component>
        <Component Id="NoticeComponent" Guid="*" Bitness="always64">
          <File Id="NoticeFile" Source="$(var.RepositoryDir)\NOTICE" Name="NOTICE.txt" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="MainFeature" Title="ViGo" Level="1">
      <ComponentRef Id="TsfComponent" />
      <ComponentRef Id="SettingsComponent" />
      <ComponentRef Id="SettingsShortcutComponent" />
      <ComponentRef Id="LicenseComponent" />
      <ComponentRef Id="NoticeComponent" />
    </Feature>

    <CustomAction
      Id="RegisterTsf"
      Directory="System64Folder"
      ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[#TsfDll]&quot;"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="RollbackUnregisterTsf"
      Directory="System64Folder"
      ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /u /s &quot;[#TsfDll]&quot;"
      Execute="rollback"
      Impersonate="no"
      Return="ignore" />
    <CustomAction
      Id="RollbackRestorePreviousTsf"
      Directory="System64Folder"
      ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[CustomActionData]&quot;"
      Execute="rollback"
      Impersonate="no"
      Return="ignore" />
    <CustomAction
      Id="UnregisterTsf"
      Directory="System64Folder"
      ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /u /s &quot;[#TsfDll]&quot;"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="RollbackRegisterTsf"
      Directory="System64Folder"
      ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[#TsfDll]&quot;"
      Execute="rollback"
      Impersonate="no"
      Return="ignore" />
    <CustomAction
      Id="RemoveCurrentUserStartup"
      Directory="System64Folder"
      ExeCommand="reg.exe delete HKCU\Software\Microsoft\Windows\CurrentVersion\Run /v ViGo /f"
      Execute="immediate"
      Impersonate="yes"
      Return="ignore" />
    <CustomAction
      Id="TestFailAfterRegister"
      Directory="System64Folder"
      ExeCommand="&quot;[System64Folder]cmd.exe&quot; /d /c exit 1"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <SetProperty
      Id="RollbackRestorePreviousTsf"
      Value="[VIGO_TSF_PREVIOUS_DLL]"
      Before="RollbackRestorePreviousTsf"
      Sequence="execute"
      Condition='$TsfComponent=3 AND VIGO_TSF_PREVIOUS_DLL' />

    <InstallExecuteSequence>
      <Custom
        Action="RollbackRegisterTsf"
        Before="UnregisterTsf"
        Condition='(?TsfComponent=3) AND ($TsfComponent=2)' />
      <Custom
        Action="UnregisterTsf"
        Before="RemoveFiles"
        Condition='(?TsfComponent=3) AND ($TsfComponent=2)' />
      <Custom
        Action="RemoveCurrentUserStartup"
        After="InstallFinalize"
        Condition='REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE' />
      <Custom
        Action="RollbackRestorePreviousTsf"
        Before="InstallFiles"
        Condition='$TsfComponent=3 AND VIGO_TSF_PREVIOUS_DLL' />
      <Custom
        Action="RollbackUnregisterTsf"
        After="InstallFiles"
        Condition='$TsfComponent=3 AND NOT VIGO_TSF_PREVIOUS_DLL' />
      <Custom
        Action="RegisterTsf"
        After="RollbackUnregisterTsf"
        Condition='$TsfComponent=3' />
      <Custom
        Action="TestFailAfterRegister"
        After="RegisterTsf"
        Condition='VIGO_TEST_FAIL_AFTER_REGISTER=1' />
    </InstallExecuteSequence>
  </Package>
</Wix>
