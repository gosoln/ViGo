<?xml version="1.0" encoding="UTF-8"?>
<component>
  <name>com.gosoln.inputmethod.ViGo</name>
  <description>ViGo Vietnamese input method</description>
  <exec>@CMAKE_INSTALL_FULL_LIBEXECDIR@/ibus-engine-vigo</exec>
  <version>2.0.0</version>
  <license>GPL-3.0-or-later</license>
  <author>ViGo contributors</author>
  <homepage>https://github.com/gosoln/ViGo</homepage>
  <textdomain>vigo</textdomain>
  <engines>
    <engine>
      <name>vigo-telex</name>
      <longname>ViGo Telex</longname>
      <language>vi</language>
      <license>GPL-3.0-or-later</license>
      <author>ViGo contributors</author>
      <icon>vigo-ibus</icon>
      <layout>us</layout>
      <symbol>V</symbol>
    </engine>
    <engine>
      <name>vigo-vni</name>
      <longname>ViGo VNI</longname>
      <language>vi</language>
      <license>GPL-3.0-or-later</license>
      <author>ViGo contributors</author>
      <icon>vigo-ibus</icon>
      <layout>us</layout>
      <symbol>V</symbol>
    </engine>
  </engines>
</component>
